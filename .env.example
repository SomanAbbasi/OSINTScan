# ==============================================================================
# OSINTScan Unified Environment Configuration Template (.env.example)
# Duplicate this file to .env and configure values for your environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
# Base URL of the backend API (e.g., http://localhost:8000 for local dev or production URL)
NEXT_PUBLIC_API_BASE_URL=

# Local API fallback URL (optional, defaults to http://localhost:8000)
NEXT_PUBLIC_LOCAL_API_BASE_URL=

# Canonical URL of the frontend deployment (e.g., https://www.osintscan.app)
NEXT_PUBLIC_SITE_URL=

# Toggle telemetry / analytics (true/false)
ENABLE_ANALYTICS=

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Environment mode (development / staging / production)
ENVIRONMENT=

# Core API metadata
PROJECT_NAME=
VERSION=
API_V1_STR=

# Allowed CORS Origins (comma-separated list or JSON array)
CORS_ORIGINS=

# Scan Concurrency & Execution Budgets
SCAN_MAX_CONCURRENCY=
SCAN_SITE_TIMEOUT_SECONDS=
SCAN_TOTAL_TIMEOUT_SECONDS=
SCAN_MAX_PER_IP=
RATE_LIMIT_WINDOW_SECONDS=

# Scanner User-Agent header
USER_AGENT=

# Optional Commercial / Authenticated Third-Party OSINT Keys
# HaveIBeenPwned API Key for live breach queries
HIBP_API_KEY=

# GHunt Google Cloud / OAuth Tokens
GHUNT_MASTER_TOKEN=
GHUNT_CREDS=

# Admin Authentication Token for /api/v1/admin/health-metrics
ADMIN_API_KEY=

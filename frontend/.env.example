# ==============================================================================
# OSINTScan Frontend Environment Configuration Template (.env.example)
# Duplicate this file to .env.local and configure values for your environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# URL of the running FastAPI backend
NEXT_PUBLIC_API_BASE_URL=

# Local API fallback URL (optional)
NEXT_PUBLIC_LOCAL_API_BASE_URL=

# Canonical URL of the frontend site
NEXT_PUBLIC_SITE_URL=

# Optional Analytics (true/false)
ENABLE_ANALYTICS=

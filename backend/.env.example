# ==============================================================================
# OSINTScan Backend Environment Configuration Template (.env.example)
# Duplicate this file to .env and configure values for your environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

ENVIRONMENT=
PROJECT_NAME=
VERSION=
API_V1_STR=
CORS_ORIGINS=

# Scan Execution Limits
SCAN_MAX_CONCURRENCY=
SCAN_SITE_TIMEOUT_SECONDS=
SCAN_TOTAL_TIMEOUT_SECONDS=
SCAN_MAX_PER_IP=
RATE_LIMIT_WINDOW_SECONDS=

# Scanner Identity
USER_AGENT=

# Optional Commercial / Authenticated Third-Party OSINT Keys
HIBP_API_KEY=
GHUNT_MASTER_TOKEN=
GHUNT_CREDS=

# Admin Authentication
ADMIN_API_KEY=

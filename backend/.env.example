# OSINTScan Backend Configuration

# Server & Network
PROJECT_NAME="OSINTScan API"
VERSION="2.0.0"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Scan Engine Limits
SCAN_MAX_CONCURRENCY=20
SCAN_SITE_TIMEOUT_SECONDS=8.0
SCAN_TOTAL_TIMEOUT_SECONDS=90.0
SCAN_MAX_PER_IP=30
RATE_LIMIT_WINDOW_SECONDS=300

# Scanner Identity
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36"

# Optional Third-Party API Keys
HIBP_API_KEY=
GHUNT_MASTER_TOKEN=
GHUNT_CREDS=

# Admin Security
ADMIN_API_KEY=hs_admin_secret_key_change_in_production
